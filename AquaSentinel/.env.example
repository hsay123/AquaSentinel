# AquaSentinel environment variables
#
#   cp .env.example .env    then fill in the values below.
#
# .env is gitignored. Never commit a filled-in copy, and never paste a key into
# a chat channel — hand the service account JSON over as a file (see SETUP.md).

# ---------------------------------------------------------------------------
# Google Earth Engine — REQUIRED
# ---------------------------------------------------------------------------
# The team shares ONE service account so auth is identical on every laptop and
# on CI. A personal `earthengine authenticate` login writes to
# ~/.config/earthengine/credentials on the machine that ran it, which is exactly
# why a fresh clone shows "GEE Offline".

# Email of the service account that has the "Earth Engine User" role on the
# GEE Cloud project below.
GEE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Path to that service account's JSON key. Relative paths resolve against the
# repo root, so ./secrets/gee-key.json works from any directory. The key itself
# must never be committed — it is gitignored (see .gitignore).
GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-key.json

# The GEE Cloud project the credentials are used against. Must match the project
# the service account was granted Earth Engine access on.
GEE_PROJECT_ID=project-326ab593-31e9-43ed-8cd

# ---------------------------------------------------------------------------
# Google Earth Engine — optional alternatives
# ---------------------------------------------------------------------------
# Only needed if you are NOT using a service account. Leave both empty when the
# service account above is configured.
#
# Single-host deploy fallback: the verbatim contents of
# ~/.config/earthengine/credentials, rehydrated at startup. Do not use for the
# team — it re-exposes a personal OAuth refresh token.
# EE_CREDENTIALS_JSON={"client_id":"...","client_secret":"...","refresh_token":"..."}

# Solo local dev fallback: run `earthengine authenticate` once on THIS machine.
# Works, but the credential lives in your home directory and will not travel to
# another laptop or to CI.

# ---------------------------------------------------------------------------
# Optional services
# ---------------------------------------------------------------------------
# Groq (free tier at https://console.groq.com/keys) — used only to polish alert
# explanations. Unset = template explanations, which is fully functional.
# GROQ_API_KEY=gsk_...

# Where the Parquet time series / baselines live. Relative to the repo root.
# AQUASENTINEL_DATA_ROOT=./data

# Extra CORS origins for the API, comma-separated (deployed frontends).
# FRONTEND_ORIGIN=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# The map basemap is plain OpenStreetMap tiles and needs NO key — do not add
# VITE_BASEMAP_* variables back without a loud startup check, because a keyed
# tile provider degrades into an "API KEY REQUIRED" watermark instead of an
# error. See SETUP.md § Basemap.
# VITE_API_BASE=/api
# VITE_BACKEND_ORIGIN=http://localhost:8000
